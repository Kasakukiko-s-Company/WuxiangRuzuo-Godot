* text=auto

# Godot and project-authored text files use stable LF endings.
*.godot text eol=lf
*.gd text eol=lf
*.tscn text eol=lf
*.tres text eol=lf
*.gdignore text eol=lf
*.json text eol=lf
*.md text eol=lf
*.yml text eol=lf
*.yaml text eol=lf
*.tmx text eol=lf
*.tsx text eol=lf
*.py text eol=lf
*.ps1 text eol=lf

# Binary source and runtime assets must never receive line-ending conversion.
*.png binary
*.jpg binary
*.jpeg binary
*.webp binary
*.wav binary
*.ogg binary
*.mp3 binary
*.flac binary
*.ttf binary
*.otf binary
*.psd binary
*.kra binary
*.aseprite binary
